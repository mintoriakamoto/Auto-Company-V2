# Auto Company — loop configuration (copy to .auto-loop.env and edit)
# .auto-loop.env is gitignored and read by scripts/core/auto-loop.sh.
# Everything here has a safe default; set only what you need.

# --- Engine -------------------------------------------------------
# Which CLI drives each cycle. You must have installed + logged into it.
ENGINE=claude                 # claude | codex
# MODEL=                      # optional model override (empty = engine default)
# CLAUDE_PERMISSION_MODE=bypassPermissions
# CODEX_SANDBOX_MODE=danger-full-access

# --- Safety / spend ----------------------------------------------
# Hard cap on cumulative USD spend; the loop halts (BUDGET state) when hit.
# 0 = unlimited. Set this before running unattended.
MAX_TOTAL_COST_USD=0
CYCLE_TIMEOUT_SECONDS=1800     # max seconds per cycle
MAX_CONSECUTIVE_ERRORS=5       # circuit breaker threshold
LOOP_INTERVAL=30               # seconds between cycles

# --- Live metrics (close the revenue feedback loop) --------------
# Point these at your deployed product's /admin/metrics so the loop sees
# real signups/MRR/funnel each cycle and optimizes against them.
# METRICS_URL=https://your-domain/admin/metrics
# METRICS_TOKEN=              # the ADMIN_METRICS_TOKEN you set as a wrangler secret
# METRICS_FILE=              # dev alternative: a local JSON file instead of a URL

# --- Retention ----------------------------------------------------
# CONSENSUS_HISTORY_KEEP=50   # consensus snapshots to keep (0 = off)
# MAIN_LOG_KEEP=3             # rotated main-log generations to keep
