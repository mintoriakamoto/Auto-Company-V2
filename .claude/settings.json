{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": ["WebSearch", "Bash", "Edit", "Write", "WebFetch", "NotebookEdit", "Skill"],
    "ask": [],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf $HOME*)",
      "Bash(rm -rf /root*)",
      "Bash(gh repo delete*)",
      "Bash(wrangler delete*)",
      "Bash(wrangler * delete*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Read(~/.ssh/**)",
      "Read(~/.claude/**)",
      "Edit(~/.ssh/**)",
      "Edit(~/.claude/**)",
      "Edit(~/.config/**)",
      "Write(~/.ssh/**)",
      "Write(~/.claude/**)",
      "Write(~/.config/**)"
    ]
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/hooks/guard.sh"
          }
        ]
      }
    ]
  }
}
